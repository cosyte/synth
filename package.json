{
  "name": "@cosyte/synth",
  "version": "0.1.7",
  "description": "Deterministic, seedable synthetic healthcare test fixtures for Node.js and TypeScript: HL7 v2, FHIR R4 and US Core, C-CDA, X12, NCPDP, and ASTM, spec-clean by construction and never real PHI.",
  "keywords": [
    "synth",
    "synthetic-data",
    "test-fixtures",
    "fixtures",
    "healthcare",
    "interoperability",
    "hl7",
    "fhir",
    "us-core",
    "ccda",
    "x12",
    "ncpdp",
    "astm",
    "typescript"
  ],
  "homepage": "https://docs.cosyte.com/synth",
  "bugs": {
    "url": "https://github.com/cosyte/synth/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cosyte/synth.git"
  },
  "license": "MIT",
  "author": "Cosyte <hello@cosyte.com> (https://cosyte.com)",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "pnpm@10.34.5",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./hl7": {
      "import": {
        "types": "./dist/hl7/index.d.ts",
        "default": "./dist/hl7/index.mjs"
      },
      "require": {
        "types": "./dist/hl7/index.d.cts",
        "default": "./dist/hl7/index.cjs"
      }
    },
    "./fhir": {
      "import": {
        "types": "./dist/fhir/index.d.ts",
        "default": "./dist/fhir/index.mjs"
      },
      "require": {
        "types": "./dist/fhir/index.d.cts",
        "default": "./dist/fhir/index.cjs"
      }
    },
    "./ccda": {
      "import": {
        "types": "./dist/ccda/index.d.ts",
        "default": "./dist/ccda/index.mjs"
      },
      "require": {
        "types": "./dist/ccda/index.d.cts",
        "default": "./dist/ccda/index.cjs"
      }
    },
    "./x12": {
      "import": {
        "types": "./dist/x12/index.d.ts",
        "default": "./dist/x12/index.mjs"
      },
      "require": {
        "types": "./dist/x12/index.d.cts",
        "default": "./dist/x12/index.cjs"
      }
    },
    "./ncpdp": {
      "import": {
        "types": "./dist/ncpdp/index.d.ts",
        "default": "./dist/ncpdp/index.mjs"
      },
      "require": {
        "types": "./dist/ncpdp/index.d.cts",
        "default": "./dist/ncpdp/index.cjs"
      }
    },
    "./astm": {
      "import": {
        "types": "./dist/astm/index.d.ts",
        "default": "./dist/astm/index.mjs"
      },
      "require": {
        "types": "./dist/astm/index.d.cts",
        "default": "./dist/astm/index.cjs"
      }
    },
    "./deid": {
      "import": {
        "types": "./dist/deid/index.d.ts",
        "default": "./dist/deid/index.mjs"
      },
      "require": {
        "types": "./dist/deid/index.d.cts",
        "default": "./dist/deid/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "prettier": "@cosyte/prettier-config",
  "pnpm": {
    "overrides": {
      "esbuild@>=0.27.3 <0.28.2": "0.28.2",
      "js-yaml@>=4.0.0 <4.3.2": "4.3.2",
      "js-yaml@>=3.0.0 <3.15.2": "3.15.2",
      "minimatch@>=10.0.0 <11.0.1": "11.0.1"
    }
  },
  "peerDependencies": {
    "@cosyte/astm": "^0.1.6",
    "@cosyte/ccda": "^0.1.6",
    "@cosyte/deid": "^0.1.5 || ^0.2.0",
    "@cosyte/fhir": "^0.1.8",
    "@cosyte/hl7": "^0.1.8",
    "@cosyte/ncpdp": "^0.1.6",
    "@cosyte/x12": "^0.1.10"
  },
  "peerDependenciesMeta": {
    "@cosyte/astm": {
      "optional": true
    },
    "@cosyte/ccda": {
      "optional": true
    },
    "@cosyte/deid": {
      "optional": true
    },
    "@cosyte/fhir": {
      "optional": true
    },
    "@cosyte/hl7": {
      "optional": true
    },
    "@cosyte/ncpdp": {
      "optional": true
    },
    "@cosyte/x12": {
      "optional": true
    }
  },
  "scripts": {
    "build": "cosyte-process build",
    "changeset": "changeset",
    "typecheck": "cosyte-process typecheck",
    "phi-scan": "tsx scripts/phi-scan.ts",
    "check": "pnpm run check:process && pnpm run check:test-selection",
    "check:process": "cosyte-process check",
    "check:test-selection": "tsx scripts/check-test-selection.ts",
    "check:install": "node scripts/check-install.mjs",
    "check:determinism-window": "tsx scripts/determinism/check-window.ts",
    "determinism:digest": "tsx scripts/determinism/digest.ts",
    "determinism:verify": "tsx scripts/determinism/verify.ts",
    "oracle": "tsx scripts/oracle/run.ts",
    "acquire:oracle": "tsx scripts/oracle/acquire.ts",
    "check:no-emdash": "cosyte-no-emdash",
    "check:no-internal-refs": "cosyte-internal-refs",
    "check:readme": "cosyte-readme",
    "check:claude-card": "cosyte-claude-card",
    "check:catalog": "cosyte-catalog",
    "lint": "cosyte-process lint",
    "lint:fix": "cosyte-process lint --fix",
    "format": "cosyte-process format",
    "format:check": "cosyte-process format --check",
    "test": "cosyte-process test",
    "test:watch": "cosyte-process test --watch",
    "test:coverage": "cosyte-process test --coverage",
    "test:perf": "vitest run --config vitest.perf.config.ts",
    "bench:reading": "cosyte-bench run --suite bench/synth.bench.mjs --target dist/index.mjs",
    "bench:compare": "cosyte-bench compare --suite bench/synth.bench.mjs",
    "bench:profile": "node --expose-gc --enable-source-maps bench/profile.mjs dist/index.mjs",
    "fuzz": "vitest run test/property/seed-sweep.fuzz.property.test.ts",
    "examples": "tsx scripts/run-examples.ts",
    "smoke": "node scripts/smoke.mjs",
    "clean": "rm -rf dist coverage",
    "pack:docs": "cosyte-process pack-docs",
    "attw": "cosyte-attw",
    "version": "changeset version && cosyte-process sync-version && prettier --write package.json CHANGELOG.md src/index.ts",
    "release": "changeset publish",
    "prepublishOnly": "pnpm clean && pnpm typecheck && pnpm lint && pnpm test && pnpm build && pnpm attw",
    "prepare": "command -v simple-git-hooks >/dev/null 2>&1 && simple-git-hooks 1>&2 || true"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm phi-scan --staged"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@changesets/cli": "2.31.0",
    "@cosyte/astm": "^0.1.6",
    "@cosyte/bench": "^0.1.1",
    "@cosyte/ccda": "^0.1.6",
    "@cosyte/deid": "^0.2.3",
    "@cosyte/eslint-config": "^0.1.4",
    "@cosyte/fhir": "^0.1.8",
    "@cosyte/hl7": "^0.1.8",
    "@cosyte/ncpdp": "^0.1.6",
    "@cosyte/prettier-config": "^0.1.2",
    "@cosyte/process": "^0.1.7",
    "@cosyte/script-utils": "^0.1.8",
    "@cosyte/test-utils": "^0.1.3",
    "@cosyte/tsconfig": "^0.1.2",
    "@cosyte/tsup-config": "^0.1.3",
    "@cosyte/vitest-config": "^0.1.3",
    "@cosyte/x12": "^0.1.10",
    "@types/node": "^22.0.0",
    "fast-check": "4.10.2",
    "prettier": "3.9.10",
    "simple-git-hooks": "2.14.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "8.3.6",
    "vitest": "5.1.0"
  }
}
